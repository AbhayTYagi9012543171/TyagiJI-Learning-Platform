NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/tyagiji_learning
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
# Set to the number of trusted reverse-proxy hops in production (Render commonly uses 1).
TRUST_PROXY_HOPS=0
ADMIN_NAME=TyagiJI Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

PREMIUM_ENROLLMENT_OPEN=false
ENABLE_DEV_RESET=false
