NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173,http://localhost:5174
MONGODB_URI=mongodb://127.0.0.1:27017/tyagiji_learning
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
# Set to 1 when deployed behind a single trusted reverse proxy.
TRUST_PROXY_HOPS=0
ADMIN_NAME=TyagiJI Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Keep false until a verified payment provider grants premium entitlements.
PREMIUM_ENROLLMENT_OPEN=false
# Optional development-only password reset URL logging. Never enable in production.
ENABLE_DEV_RESET=false
